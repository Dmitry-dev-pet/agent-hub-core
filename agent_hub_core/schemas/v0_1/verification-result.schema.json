{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.1:verification-result",
  "title": "Agent Hub VerificationResult v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "checks",
    "authoritative_refs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "verified",
        "failed",
        "inconclusive"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "repository",
                    "file",
                    "commit",
                    "pull_request",
                    "issue",
                    "workflow_run",
                    "artifact",
                    "deployment",
                    "runtime",
                    "url",
                    "other"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "authoritative_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "workflow_run",
              "artifact",
              "deployment",
              "runtime",
              "url",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "passed": {
                  "const": true
                }
              },
              "required": [
                "passed"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "passed": {
                  "const": false
                }
              },
              "required": [
                "passed"
              ]
            }
          }
        }
      }
    }
  ]
}
