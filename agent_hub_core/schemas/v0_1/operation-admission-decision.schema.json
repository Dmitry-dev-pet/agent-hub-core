{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.1:operation-admission-decision",
  "title": "Truthrail operation admission decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "policy",
    "decision",
    "operation",
    "actor",
    "owner",
    "route",
    "contract_sha256",
    "operation_sha256",
    "requirements",
    "findings"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "operation_admission_decision" },
    "policy": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ADMIT", "REQUIRE_HUMAN", "DENY"] },
    "operation": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "route": { "enum": ["agent", "operator"] },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["manual_approval", "provider_interaction"]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "reason"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^TRA[0-9]{3}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
