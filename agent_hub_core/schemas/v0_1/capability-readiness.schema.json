{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.1:capability-readiness",
  "title": "Agent Hub CapabilityReadiness v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capability",
    "state",
    "required_for_core",
    "summary",
    "prerequisites",
    "limitations",
    "activation",
    "authoritative_refs"
  ],
  "properties": {
    "version": {"const": 1},
    "capability": {"type": "string", "minLength": 1},
    "state": {"enum": ["ready", "degraded", "dormant", "blocked"]},
    "required_for_core": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1},
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "required_for_ready",
          "user_action_required",
          "description"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "credential",
              "installation",
              "permission",
              "service",
              "workflow",
              "hardware",
              "configuration",
              "other"
            ]
          },
          "status": {"enum": ["satisfied", "missing", "not_applicable"]},
          "required_for_ready": {"type": "boolean"},
          "user_action_required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "route", "user_action_required"],
      "properties": {
        "available": {"type": "boolean"},
        "route": {
          "enum": [
            "connector",
            "reviewed_control_plane",
            "workflow",
            "manual",
            "other"
          ]
        },
        "user_action_required": {"type": "boolean"},
        "instruction_ref": {"type": "string", "minLength": 1}
      }
    },
    "authoritative_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "enum": [
                "repository", "file", "commit", "pull_request", "issue",
                "workflow_run", "artifact", "deployment", "runtime", "url", "other"
              ]
            },
            "value": {"type": "string", "minLength": 1}
          }
        }
    }
  }
}
