{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.1:execution-receipt",
  "title": "Agent Hub ExecutionReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "capability",
    "authoritative_refs",
    "observations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "const": "executed"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "workflow_run",
              "artifact",
              "deployment",
              "runtime",
              "url",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
