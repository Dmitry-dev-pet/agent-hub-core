{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.2:execution-plan",
  "title": "Truthrail ExecutionPlan v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "project",
    "selected_level",
    "reason",
    "capability",
    "acceptance_proof",
    "approval"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "selected_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_proof": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "none",
            "work_packet_policy",
            "control_plane_contract",
            "provider_interaction",
            "operator_policy"
          ]
        }
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "workflow_run",
              "artifact",
              "deployment",
              "runtime",
              "url",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
