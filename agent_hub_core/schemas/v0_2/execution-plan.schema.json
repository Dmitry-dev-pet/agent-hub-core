{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.2:execution-plan",
  "title": "Truthrail ExecutionPlan v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "project",
    "selected_level",
    "reason",
    "capability",
    "acceptance_proof",
    "approval"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "selected_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_proof": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "none",
            "work_packet_policy",
            "control_plane_contract",
            "provider_interaction",
            "operator_policy"
          ]
        }
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "workflow_run",
              "artifact",
              "deployment",
              "runtime",
              "url",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_packet_digest",
        "state_fingerprint",
        "route"
      ],
      "properties": {
        "work_packet_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "digest",
            "inputs"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "ref",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "repository_head",
                      "control_plane_contract",
                      "policy",
                      "provider_state",
                      "other"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposed",
            "policy_minimum",
            "authorized"
          ],
          "properties": {
            "proposed": {
              "enum": [
                "direct",
                "branch_pr"
              ]
            },
            "policy_minimum": {
              "enum": [
                "direct",
                "branch_pr"
              ]
            },
            "authorized": {
              "enum": [
                "direct",
                "branch_pr"
              ]
            }
          }
        },
        "execution_venue": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
