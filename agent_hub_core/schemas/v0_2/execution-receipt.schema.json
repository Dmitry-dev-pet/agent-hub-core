{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub-core:v0.2:execution-receipt",
  "title": "Truthrail ExecutionReceipt v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "status",
    "capability",
    "approval",
    "authoritative_refs",
    "observations"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "const": "executed"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_required",
            "approved"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authoritative_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "workflow_run",
              "artifact",
              "deployment",
              "runtime",
              "url",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "approval"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "required": [
              "status",
              "reference"
            ]
          }
        }
      }
    }
  ]
}
